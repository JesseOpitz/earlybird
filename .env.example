# .env.example

# Web Environment Variables
WEB_HOST=localhost
WEB_PORT=3000

# API Environment Variables
API_HOST=localhost
API_PORT=4000

# Worker Environment Variables
WORKER_QUEUE=myqueue
WORKER_RETRY_COUNT=5

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# External Services
EXTERNAL_API_KEY=myapikey
EXTERNAL_API_URL=https://api.example.com
